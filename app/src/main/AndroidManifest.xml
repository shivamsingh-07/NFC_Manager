<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC -->
    <uses-permission android:name="android.permission.NFC" />
    <!--
      NFC controller is required for both halves of the app
      (read tags + emulate NDEF Type 4 to share with another phone).
    -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />
    <!--
      HCE is required for the "Emulate" / device-to-device sender path:
      Android Beam (NDEF push) was removed in Android 14, so HCE NDEF
      Type 4 emulation is the only sanctioned device-to-device transport.
    -->
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="true" />

    <!-- Wi-Fi (for Wi-Fi tag connect via suggestion) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibration for tap / write feedback (does not require runtime grant). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Contacts (for vCard save via Intent insert — no read/write; we use ACTION_INSERT) -->
    <!-- Intentionally omitting READ/WRITE_CONTACTS because we use the secure system picker. -->

    <!-- Query specific intents we launch (browser, contacts insert, share) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Enumerate launchable apps for the "Open App" action picker (Android 11+ visibility). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NfcManagerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NFCManager"
        android:enableOnBackInvokedCallback="@bool/enable_predictive_back"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.NFCManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          System NFC dispatch: lightweight translucent task + bottom sheet
          only (see NfcDispatchActivity). Keeps passive reads from pulling the
          full main UI over other apps.

          Intent filters are intentionally narrow:
            - NDEF_DISCOVERED is registered ONLY for MIME types we have
              first-class parsers / UX for (vCard, Wi-Fi WSC, Bluetooth OOB).
              Earlier we used `mimeType="*/*"` which made us a candidate for
              every NDEF tap and caused the OS to show a chooser on phones
              that ship a built-in NDEF service (Samsung's "Embedded Tag",
              MIUI's "NFC Tag", etc.). For text / URL records the OS handles
              them natively when the app is backgrounded; when foregrounded,
              MainActivity registers Foreground Dispatch and wins instead.
            - TECH_DISCOVERED with our nfc_tech_filter catches raw tag tech
              dispatch when no app handled NDEF.
            - TAG_DISCOVERED is the absolute last-resort fallback.
        -->
        <activity
            android:name=".NfcDispatchActivity"
            android:exported="true"
            android:theme="@style/Theme.NfcDispatchOverlay"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=".nfc.dispatch"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <!-- vCard contact tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
            </intent-filter>
            <!-- Wi-Fi Simple Configuration (WPS) tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.wfa.wsc" />
            </intent-filter>
            <!-- Bluetooth Out-Of-Band pairing tags. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.bluetooth.ep.oob" />
                <data android:mimeType="application/vnd.bluetooth.le.oob" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.nfc.MessageEmulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>

    </application>

</manifest>
